name: "nginx_dashboard"
description: "Standalone element: provisions the Nginx dashboard (traffic, errors, response time and clients from the access log, plus exporter connection counters) onto the shared observability Grafana instance."
schema_version: 1
version: "{{ version }}"
api_version: "v1"

requirements:
  core:
    from_version: "0.2.30"
  grafanaaas:
    from_version: "0.0.0"
  observability:
    from_version: "0.0.1"

resources:

  # Our own dashboard, vendored under dashboards/ and published as a repo
  # artifact. Most panels read the nginx access log (JSON shipped through
  # journald to VictoriaLogs), the connection panels read the
  # nginx-prometheus-exporter metrics. The log format nginx must use is in
  # docs/HOWTO.md.
  $grafanaaas.types.grafana.dashboards:
    nginx:
      name: "nginx"
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      source:
        kind: urn
        urn: "{{ artifacts.nginx_dashboard }}"

  # Bind the artifact to the shared Grafana instance owned by the
  # `observability` element. The nested collection is addressed through the
  # import, not the original resource path (the imported resource is
  # registered in the element engine under
  # $nginx_dashboard.imports.$grafana_instance).
  $nginx_dashboard.imports.$grafana_instance.dashboards:
    nginx_binding:
      name: "nginx"
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      instance: $nginx_dashboard.imports.$grafana_instance:uuid
      folder: "Nginx"
      version_ref: $grafanaaas.types.grafana.dashboards.$nginx:version_ref

imports:
  grafana_instance:
    element: "$observability"
    kind: "resource"
    link: "$grafanaaas.types.grafana.instances.$grafana"
