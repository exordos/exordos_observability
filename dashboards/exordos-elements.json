{
  "__inputs": [
    {
      "name": "DS_Metrics",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Exordos Elements",
  "uid": "exordos-elements",
  "description": "Status of Exordos elements and their resources, current and over time. Fed by the core state metrics (exordos_em_*), which exordos_core writes every 15s for the node_exporter textfile collector.",
  "tags": [
    "exordos",
    "elements"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "DS_Metrics",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "element",
        "label": "Element",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_Metrics}"
        },
        "definition": "label_values(exordos_em_element_status, element)",
        "query": {
          "qryType": 1,
          "query": "label_values(exordos_em_element_status, element)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "kind",
        "label": "Kind",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_Metrics}"
        },
        "definition": "label_values(exordos_em_resource_status{element=~\"$element\"}, kind)",
        "query": {
          "qryType": 1,
          "query": "label_values(exordos_em_resource_status{element=~\"$element\"}, kind)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
