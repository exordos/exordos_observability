    {
      "id": 2,
      "type": "stat",
      "title": "Elements",
      "description": "Number of elements (filtered by the variables).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_Metrics}"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_Metrics}"
          },
          "expr": "count(exordos_em_element_status{element=~\"$element\"})",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "showPercentChange": false
