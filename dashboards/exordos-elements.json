    {
      "id": 11,
      "type": "table",
      "title": "Elements",
      "description": "Current status of every element. \"Not ACTIVE in range\" is how long the element spent outside ACTIVE within the selected time range. Click an element name to focus the dashboard on it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_Metrics}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_Metrics}"
          },
          "expr": "max without (instance, job) (exordos_em_element_status{element=~\"$element\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_Metrics}"
          },
          "expr": "max without (instance, job) (exordos_em_element_info{element=~\"$element\"})",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_Metrics}"
          },
          "expr": "max without (instance, job) ((1 - share_eq_over_time(exordos_em_element_status{element=~\"$element\"}[$__range], 3)) * lifetime(exordos_em_element_status{element=~\"$element\"}[$__range]) and on(element) exordos_em_element_status{element=~\"$element\"})",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "Value #B": true,
              "element_uuid": true,
              "project_id": true
            },
            "indexByName": {
              "element": 0,
              "Value #A": 1,
              "version": 2,
              "install_type": 3,
              "Value #C": 4
            },
            "renameByName": {
              "element": "Element",
              "Value #A": "Status",
              "version": "Version",
              "install_type": "Install type",
              "Value #C": "Not ACTIVE in range"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Status"
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "NEW",
                        "color": "blue",
                        "index": 0
                      },
                      "2": {
                        "text": "IN_PROGRESS",
                        "color": "orange",
                        "index": 1
                      },
                      "3": {
                        "text": "ACTIVE",
                        "color": "green",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Not ACTIVE in range"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Element"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Focus on ${__value.text}",
                    "url": "/d/exordos-elements/exordos-elements?var-element=${__value.text}&${__url_time_range}&${DS_Metrics:queryparam}"
                  }
                ]
              }
            ]
          }
        ]
