[Unit]
Description=Exordos MetaPaaS VictoriaLogs (single-node)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/exordos_metapaas/victoria.env

[Service]
Type=simple
EnvironmentFile=/etc/exordos_metapaas/victoria.env
ExecStart=/usr/bin/victoria-logs \
    -retentionPeriod=${VL_RETENTION_PERIOD} \
    -storageDataPath=${VL_STORAGE_DATA_PATH} \
    -httpListenAddr=${VL_HTTP_LISTEN_ADDR}
Restart=always
RestartSec=10s
TimeoutStartSec=30s
TimeoutStopSec=30s
SendSIGKILL=no
KillSignal=SIGTERM
OOMScoreAdjust=-1000
LimitNOFILE=1048576
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
